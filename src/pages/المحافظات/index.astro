---
import Layout from '../../layouts/Layout.astro';
import { governorates } from '../../data/governorates';
---
<Layout title="قص الخرسانة وفتحات الكور في جميع محافظات مصر | إنجاز دريل" description="اختر محافظتك لطلب صنايعي كور أو قص خرسانة. إنجاز دريل تنفذ الطلبات الصغيرة والمشروعات في أنحاء مصر مع تنسيق الانتقال والمقاسات والموعد.">
<section class="home-wrap home-section"><span class="kicker">نصل إلى موقعك في أنحاء مصر</span><h1>قص وتخريم الخرسانة في جميع محافظات مصر <bdi class="heading-phone">| 01029834485</bdi></h1><p>نقبل الفتحة الواحدة وأعمال المشروعات. اختر المحافظة لمعرفة نطاق الخدمة والبيانات المطلوبة، ثم أرسل الموقع والمقاسات لتنسيق انتقال الفريق والمعدات وتأكيد السعر والموعد.</p><div class="governorates">{governorates.map(g=><a href={`/المحافظات/${g.name}/`}><h2>{g.label}</h2><p>{g.places}</p><span>الخدمات وطلب عرض السعر ←</span></a>)}</div><p>صفحات المحافظات توضح مناطق تقديم الخدمة ولا تعني وجود فروع محلية. تكلفة الانتقال وترتيبات الوصول تُراجع قبل الاتفاق.</p></section>
</Layout>
<style>h1{font-size:clamp(28px,4vw,44px);line-height:1.6}p{line-height:2;margin:20px 0}.governorates{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:35px 0}.governorates a{padding:24px;border:1px solid #dce1d3;border-radius:8px;background:white}.governorates h2{font-size:23px}.governorates p{font-size:13px;color:#63716c}.governorates span{font-size:13px;color:#b94029}@media(max-width:800px){.governorates{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.governorates{grid-template-columns:1fr}}</style>
