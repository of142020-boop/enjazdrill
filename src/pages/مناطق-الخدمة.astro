---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';
const areas = [
 {id:'october',name:'6 أكتوبر',text:'لطلب قص الخرسانة أو فتحات الكور في مدينة 6 أكتوبر، أرسل اسم الحي أو المنطقة والطابق، وحدد هل المكان تحت الإنشاء أم مشطب. صور مدخل الموقع ونقطة العمل تساعد على مراجعة وصول المعدات والتجهيزات المطلوبة.'},
 {id:'zayed',name:'الشيخ زايد',text:'نراجع طلبات الكور وقص الخرسانة وتركيب الشفاطات في الشيخ زايد. عند وجود إدارة للكمبوند، وضّح شروط دخول الفنيين ومواعيد العمل المسموحة وأي موافقات على الواجهة أو مسار التهوية قبل تنسيق الزيارة.'},
 {id:'gardens',name:'حدائق أكتوبر',text:'لأعمال تأسيس السباكة والتكييف والشفاطات في حدائق أكتوبر، جهز عدد الفتحات وأقطارها ومواقعها قبل الحجز. نسّق المقاسات مع مسؤول التمديدات، ووضح توفر الماء والكهرباء وحالة التشطيب.'},
 {id:'greater-cairo',name:'القاهرة والجيزة والقرية الذكية',text:'تُراجع الطلبات في هذه المناطق حسب الموقع ونوع العمل وإمكانية الوصول. أرسل العنوان التقريبي ونطاق التنفيذ لتأكيد التغطية والموعد وأي متطلبات انتقال ضمن عرض السعر.'}
];
---
<Layout title="مناطق خدمة قص الخرسانة والكور في أكتوبر وزايد | إنجاز دريل" description="تعرف على نطاق خدمة إنجاز دريل في 6 أكتوبر والشيخ زايد وحدائق أكتوبر والقاهرة والجيزة، وبيانات الموقع المطلوبة لتنسيق القص والتخريم وتركيب الشفاطات.">
 <article class="home-wrap home-section areas-page">
 <nav aria-label="مسار الصفحة"><a href="/">الرئيسية</a> / مناطق الخدمة</nav>
 <h1>مناطق خدمة إنجاز دريل للقص والتخريم وتركيب الشفاطات <bdi class="heading-phone">| 01029834485</bdi></h1>
 <p>نبدأ من مدينة 6 أكتوبر لخدمة طلبات قص الخرسانة بالمنشار وفتحات الكور وتأسيس شفاطات المطبخ. اختر منطقتك واقرأ بيانات التجهيز المطلوبة، ثم أرسل تفاصيل العمل لتأكيد إمكانية التنفيذ والموعد. المناطق التالية نطاقات خدمة، ولا تعني وجود فرع في كل منطقة.</p>
 <p>نعمل أيضًا في جميع محافظات مصر ونقبل الطلبات الصغيرة والمشروعات. <a href="/المحافظات/">اختر محافظتك من دليل التغطية الكامل</a>.</p><div class="area-nav">{areas.map(a=><a href={`#${a.id}`}>{a.name}</a>)}</div>
 {areas.map(a=><section id={a.id}><h2>قص الخرسانة وفتحات الكور في {a.name}</h2><p>{a.text}</p><ul>{services.map(s=><li><a href={`/${s.slug}/`}>{s.title.split(' في ')[0]}</a></li>)}</ul><a class="text-link" href={`https://wa.me/201029834485?text=${encodeURIComponent(`مرحبًا إنجاز دريل، أريد مراجعة طلب خدمة في ${a.name}. الخدمة والمقاسات: `)}`}>استفسر عن التنفيذ في {a.name} ←</a></section>)}
 <section><h2>ماذا نحتاج قبل تأكيد الزيارة؟</h2><p>المنطقة والطابق ونوع الخدمة والمقاسات وعدد الفتحات، وصور واضحة لمكان التنفيذ. وضّح متطلبات الدخول وحماية التشطيبات، وأرسل المخطط المعتمد عند وجود تعديل إنشائي. يحدد نطاق العمل والسعر بعد مراجعة هذه التفاصيل، والمعاينة عند الحاجة.</p><p><a href="/اسعار-قص-وتخريم-الخرسانة/">راجع عوامل التسعير</a> أو <a href="/اتصل-بنا/">تواصل مع فريقنا</a>.</p></section>
 </article>
</Layout>
<style>
.areas-page{max-width:950px;line-height:2.1}.areas-page h1{font-size:clamp(28px,4vw,44px);line-height:1.6;margin:24px 0}.areas-page h2{font-size:26px;margin-bottom:18px}.areas-page section{padding:30px;border:1px solid #dce1d3;border-radius:8px;margin-top:25px;scroll-margin-top:110px}.areas-page ul{list-style:disc;padding-inline-start:22px;margin:18px 0}.areas-page li a,.areas-page p a{text-decoration:underline}.area-nav{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.area-nav a{padding:8px 16px;background:#e9eddf;border-radius:5px}@media(max-width:600px){.areas-page section{padding:20px}}
</style>
