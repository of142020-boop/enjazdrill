---
import SiteImage from '../components/SiteImage.astro';
import Layout from '../layouts/Layout.astro';
import HomeGuide from '../components/HomeGuide.astro';
const services = [
 {image:'منشار-قص-الجدران.webp', title:'قص الخرسانة بالمنشار', tag:'CONCRETE CUTTING', desc:'قص الجدران والأسقف وفتح الأبواب والنوافذ بالمنشار الماسي، وفق المقاسات وخطة التنفيذ المعتمدة.', link:'/قص-خرسانة/'},
 {image:'تخريم-خرسانة-كور.webp', title:'تخريم وفتحات الكور', tag:'CORE DRILLING', desc:'فتحات دائرية لتمديدات السباكة والتكييف والكهرباء، مع مراجعة القطر والسماكة ومكان الفتحة.', link:'/فتحات-كور-أكتوبر-وزايد/'},
 {image:'فتحات-تهوية-وتكييف.webp', title:'تأسيس وتركيب الشفاطات', tag:'VENTILATION', desc:'تجهيز فتحة الشفاط ومسار التهوية وتركيب الجهاز حسب الموديل ومتطلبات موقعك.', link:'/تركيب-شفاط-المطبخ/'}
];
const faq = [
 {q:'ما الفرق بين قص الخرسانة بالمنشار وتخريم الكور؟', a:'المنشار يستخدم لخطوط القص والفتحات المستطيلة بحسب خطة المشروع، بينما الكور يعمل فتحات دائرية للتمديدات. نراجع الشكل والمقاس وطبيعة العنصر قبل تحديد الخدمة المناسبة.'},
 {q:'هل تقدمون تأسيس فتحة الشفاط وتركيب الجهاز معًا؟', a:'يمكن طلب مراجعة التأسيس والتركيب ضمن نطاق واحد، مع تحديد موديل الجهاز ومسار الدكت والخامات المطلوبة. نؤكد إمكانية تنفيذ المطلوب وما يشمله العرض بعد الاطلاع على التفاصيل.'},
 {q:'كيف يتم تحديد سعر قص الخرسانة أو فتحة الكور؟', a:'يعتمد السعر على أبعاد القطع أو قطر الفتحة، وسماكة الخرسانة، والعدد، وارتفاع العمل وموقعه. أرسل صورًا ومقاسات للحصول على تقدير، وقد يلزم إجراء معاينة قبل تأكيد السعر.'},
 {q:'ما المناطق التي تخدمها إنجاز دريل؟', a:'ننقل الفريق والمعدات لتنفيذ الطلبات الصغيرة والمشروعات في جميع محافظات مصر. أرسل المدينة أو القرية والمقاسات لتنسيق الانتقال والموعد وتأكيد التكلفة قبل الاتفاق.'},
 {q:'هل يمكن تنفيذ العمل في شقة تم تشطيبها؟', a:'نراجع حماية الأرضيات والأثاث واحتواء مياه التبريد والمخلفات قبل التنفيذ. القص والتخريم ينتجان صوتًا ومخلفات؛ لذلك نحدد التجهيزات المناسبة حسب حالة المكان.'},
 {q:'هل تحتاج فتحة الباب أو السقف إلى مراجعة مهندس؟', a:'أي تعديل في العناصر الإنشائية يستلزم مراجعة واعتماد المهندس المختص قبل التنفيذ. نحتاج تحديد موضع القطع ومقاساته ومتطلبات التدعيم ضمن نطاق العمل.'}
];
---
<Layout title="إنجاز دريل | قص وتخريم الخرسانة في أكتوبر والشيخ زايد" description="قص الخرسانة بالمنشار الماسي، فتحات الكور وتركيب الشفاطات في 6 أكتوبر والشيخ زايد والقاهرة. أرسل مقاسات مشروعك واطلب عرض سعر من إنجاز دريل." canonical="https://enjazdrill.com/" ogImage="/images/منشار-قص-الجدران.webp">
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))})}/>
 <section class="home-hero">
  <div class="home-wrap hero-grid">
   <div class="hero-copy">
    <span class="eyebrow"><span class="status-dot"></span> إنجاز دريل · حلول القص والتخريم</span>
    <h1>قص وتخريم الخرسانة<br/><span>في أكتوبر والشيخ زايد.</span> <bdi class="heading-phone">| 01029834485</bdi></h1>
    <p>قص وتخريم الخرسانة المسلحة في أكتوبر والشيخ زايد والقاهرة. من فتحة كور واحدة إلى أعمال القص في مشروعك، نبدأ بفهم التفاصيل ونحدد معك طريقة التنفيذ.</p>
    <div class="hero-actions"><a class="btn-primary" href="#request">اطلب عرض سعر <span aria-hidden="true">↙</span></a><a class="outline-btn" href="tel:+201029834485">اتصل بنا <bdi>01029834485</bdi></a></div>
    <div class="hero-notes"><span>✓ مقاسات محددة</span><span>✓ تجهيز للموقع</span><span>✓ نطاق عمل واضح</span></div>
   </div>
   <div class="hero-visual">
    <SiteImage src="/images/منشار-قص-الجدران.webp" alt="معدات قص الجدران الخرسانية بالمنشار في موقع العمل" width="1200" height="690" fetchpriority="high" loading="eager"/>
    <div class="image-label"><span class="crosshair" aria-hidden="true">⊕</span><div><strong>المعدة المناسبة. للنتيجة المطلوبة.</strong><small>قص بالمنشار الماسي · تخريم كور</small></div></div>
    <span class="visual-index" aria-hidden="true">ENJAZ / PRECISION AT WORK</span>
   </div>
  </div>
 </section>
 <div class="expertise-strip"><div class="home-wrap"><span>حلول للمنازل والمشروعات</span><strong>قص الجدران والأسقف</strong><span aria-hidden="true">✳</span><strong>فتحات التمديدات</strong><span aria-hidden="true">✳</span><strong>تأسيس التهوية والشفاطات</strong></div></div>
 <section class="home-section home-wrap" id="services">
  <div class="section-heading"><div><span class="kicker">01 / خدماتنا</span><h2>خدمات قص الخرسانة والكور والشفاطات</h2></div><a class="text-link" href="/الخدمات/">استكشف كل الخدمات ←</a></div>
  <div class="home-services">{services.map((s,i)=><article class="home-service"><a href={s.link} class="service-photo"><SiteImage src={`/images/${s.image}`} alt={s.title} width="600" height="420" loading="lazy"/><span class="service-number">0{i+1}</span></a><div class="home-service-content"><span class="english-tag">{s.tag}</span><h3><a href={s.link}>{s.title}</a></h3><p>{s.desc}</p><a class="text-link" href={s.link}>تفاصيل الخدمة <span aria-hidden="true">↖</span></a></div></article>)}</div>
 </section>
 <section class="approach-section"><div class="home-wrap approach-grid"><div class="approach-photo"><SiteImage src="/images/ماكينة-كور-دريل-الماني.webp" alt="ماكينة تخريم كور لتنفيذ فتحات الخرسانة" width="700" height="700" loading="lazy"/><span>تفاصيل صغيرة. فرق كبير.</span></div><div><span class="kicker">02 / طريقة شغلنا</span><h2>الشغل المحسوب<br/>يبدأ قبل تشغيل المعدة.</h2><p class="section-intro">نراجع المطلوب وظروف المكان، لتكون المقاسات والتجهيزات والتكلفة واضحة قبل بداية العمل.</p><div class="approach-item"><b>01</b><div><h3>نسمع تفاصيل مشروعك</h3><p>صور الموقع، نوع الخدمة، المقاسات والمنطقة.</p></div></div><div class="approach-item"><b>02</b><div><h3>نراجع ونحدد نطاق التنفيذ</h3><p>اختيار المعدة، مراجعة الموافقات المطلوبة والاتفاق على السعر والموعد.</p></div></div><div class="approach-item"><b>03</b><div><h3>نجهز الموقع وننفذ</h3><p>حماية محيط العمل وتنفيذ المطلوب ومراجعة المقاسات المتفق عليها.</p></div></div></div></div></section>
 <section class="home-section home-wrap"><div class="section-heading"><div><span class="kicker">03 / من موقع العمل</span><h2>تفاصيل التنفيذ تتكلم.</h2></div><a class="text-link" href="/projects/">شاهد معرض الأعمال ←</a></div><div class="work-grid">{[{img:'تخريم-خرسانة-للسقف.webp',title:'تخريم الأسقف الخرسانية',type:'فتحات التمديدات'},{img:'عمل-فتحات-كور-للأرضيات.webp',title:'فتحات كور للأرضيات',type:'أعمال الكور'},{img:'منشار-قص-الخرسانة.webp',title:'أعمال قص الخرسانة',type:'المنشار الماسي'}].map(p=><a class="work-card" href="/projects/"><SiteImage src={`/images/${p.img}`} alt={p.title} width="600" height="520" loading="lazy"/><div><small>{p.type}</small><h3>{p.title} <span aria-hidden="true">↖</span></h3></div></a>)}</div></section>
 <HomeGuide />
 <section class="home-wrap home-section"><span class="kicker">تغطية جميع محافظات مصر</span><h2>من فتحة كور واحدة إلى أعمال المشروعات</h2><p class="section-intro">ننتقل لتنفيذ أعمال الكور وقص الخرسانة في أنحاء مصر. اختر محافظتك وأرسل المقاسات والموقع لتأكيد تكلفة الانتقال والتجهيزات والموعد.</p><a class="btn-primary" href="/المحافظات/">اختر محافظتك واطلب الخدمة ←</a></section>
 <section class="coverage-section"><div class="home-wrap coverage-inner"><div><span class="kicker">قريبين من مشروعك</span><h2>خدماتنا في أكتوبر وزايد والقاهرة</h2><p>نستقبل طلبات مدينة 6 أكتوبر والشيخ زايد وحدائق أكتوبر والقرية الذكية والقاهرة والجيزة. أرسل اسم الحي أو الكمبوند والطابق لتأكيد التغطية ومتطلبات الدخول وموعد التنفيذ.</p></div><a class="text-link" href="/مناطق-الخدمة/">تفاصيل مناطق الخدمة وتجهيز الزيارة ←</a><div class="area-tags">{['6 أكتوبر','الشيخ زايد','حدائق أكتوبر','القرية الذكية','القاهرة','الجيزة'].map(a=><span>{a}</span>)}</div></div></section>
 <section class="home-section home-wrap faq-grid"><div><span class="kicker">04 / أسئلة قبل البداية</span><h2>كل ما تحتاج<br/>معرفته قبل التنفيذ.</h2><p class="section-intro">عندك تفاصيل مختلفة؟ اتصل بنا ونراجعها معك.</p><a class="text-link" href="tel:+201029834485">تحدث مع فريقنا ←</a></div><div>{faq.map(f=><details class="faq-accordion"><summary>{f.q}</summary><p class="faq-content">{f.a}</p></details>)}</div></section>
 <section class="request-section" id="request"><div class="home-wrap request-grid"><div><span class="kicker">نبدأ بمشروعك؟</span><h2>أرسل التفاصيل.<br/>ونرتب الخطوة الجاية.</h2><p>اختر الخدمة واكتب المنطقة والمقاسات. سنجهز رسالتك على واتساب لتراجعها وترسلها لفريقنا.</p><a class="request-phone" href="tel:+201029834485"><bdi>01029834485</bdi> ↖</a></div><form id="quote-form" action="https://wa.me/201029834485" method="get"><label for="quote-service">الخدمة المطلوبة</label><select id="quote-service" required><option value="">اختر الخدمة</option>{services.map(s=><option>{s.title}</option>)}<option>أعمال أخرى</option></select><label for="quote-area">منطقة العمل</label><input id="quote-area" required maxlength="150" placeholder="مثال: الشيخ زايد، الحي التاسع" autocomplete="address-level2"/><label for="quote-details">تفاصيل ومقاسات العمل</label><textarea id="quote-details" name="text" required maxlength="2000" rows="3" placeholder="عدد الفتحات، القطر أو أبعاد القص، وسماكة الخرسانة إن توفرت"></textarea><button class="btn-primary" type="submit">تجهيز الطلب على واتساب ↖</button><small>السعر النهائي بعد مراجعة التفاصيل، والمعاينة عند الحاجة.</small></form></div></section>
</Layout>
<script>
 document.getElementById('quote-form')?.addEventListener('submit', (event) => {
  event.preventDefault();
  const service = (document.getElementById('quote-service') as HTMLSelectElement).value;
  const area = (document.getElementById('quote-area') as HTMLInputElement).value.trim();
  const details = (document.getElementById('quote-details') as HTMLTextAreaElement).value.trim();
  window.open(`https://wa.me/201029834485?text=${encodeURIComponent(`مرحبًا إنجاز دريل، أريد عرض سعر.\nالخدمة: ${service}\nالمنطقة: ${area}\nالتفاصيل: ${details}`)}`, '_blank', 'noopener,noreferrer');
 });
</script>
